# Environment variable NAMES only. Never commit a value.

# SQLite by default. Postgres is this string plus a driver.
DATABASE_URL=

# Static bearer expected from the frontend proxy. UNSET = auth disabled,
# mirroring the proxy, which omits the header entirely when unset. Leave both
# sides unset for the local demo.
API_TOKEN=

# Comma-separated. Only matters for Swagger UI and direct curl — the Next.js
# server calls this service, and server-to-server has no preflight.
CORS_ORIGINS=

# Base URL used to build absolute audio_url values.
PUBLIC_BASE_URL=
