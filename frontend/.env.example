# Environment variable NAMES only. Never commit a value.
# Copy to .env.local for local development; .env* is gitignored.

# Base URL of the backend API, e.g. http://localhost:8080
# Leave unset to run entirely against fixtures in src/lib/fixtures.
BACKEND_URL=

# Milliseconds before a backend call is abandoned. Defaults to 5000.
BACKEND_TIMEOUT_MS=

# WARNING: anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle
# and is public by definition. Never put a secret behind that prefix.
