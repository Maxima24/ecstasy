# Environment variable NAMES only. Never commit a value.
#
# Copy to .env.local (gitignored) and fill in.

# Base URL of the backend service.
#
# THIS IS THE FIXTURE SWITCH. Unset or empty means every route answers from
# src/lib/fixtures/ and no network call is made. Setting it turns all fixtures
# off at once, and unsetting it is the complete rollback.
BACKEND_URL=

# Static bearer forwarded upstream, held server-side; the browser never sees it.
#
# When UNSET the Authorization header is omitted entirely, and the backend
# treats "no token configured" as auth disabled. So "unset on both sides" is a
# working local configuration rather than a 401 loop.
API_TOKEN=

# How long to wait for the backend before returning 504. Must be a POSITIVE
# number; the app refuses to start otherwise.
BACKEND_TIMEOUT_MS=

# Artificial delay on fixture responses, so loading states are built honestly
# rather than against an instant local call. Ignored once BACKEND_URL is set.
#
# ZERO IS VALID and means no delay, which is what you want before recording.
FIXTURE_DELAY_MS=
